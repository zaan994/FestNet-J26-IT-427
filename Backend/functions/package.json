{
  "name": "festnet-functions",
  "description": "FestNet Firebase Cloud Functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only database --project demo-festnet \"vitest run --config vitest.emulator.config.ts\"",
    "serve": "npm run build && firebase emulators:start --only functions,database,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.10.0",
    "firebase": "^11.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
