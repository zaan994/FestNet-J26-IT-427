# Copy to .env (gitignored).

FIREBASE_PROJECT_ID=festnetproject
FIREBASE_DATABASE_URL=https://festnetproject-default-rtdb.firebaseio.com

# --- Option A: real project ---
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Save it OUTSIDE the repo (or as serviceAccount.json here — it is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# --- Option B: local emulators (cd Backend && firebase emulators:start) ---
# Uncomment both lines and comment out GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
