# Copy to .env.local and fill in from Firebase console -> Project settings -> Your apps -> Web app.
# These values are public client config (not secrets), but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=festnetproject.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://festnetproject-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=festnetproject
VITE_FIREBASE_STORAGE_BUCKET=festnetproject.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase emulators (cd Backend && firebase emulators:start)
VITE_USE_EMULATORS=false
